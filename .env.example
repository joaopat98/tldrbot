BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key

# Any OpenAI-compatible Chat Completions API; leave unset for OpenAI.
# OpenWebUI example (use its API key above and a model ID it provides below):
# OPENAI_BASE_URL=https://openwebui.example.test/api

# Optional settings
AI_MODEL=gpt-4o-mini
DAILY_LIMIT=10
MAX_MESSAGES=400
# External analytics database (use a host reachable from the container).
# DATABASE_URL=postgresql://user:password@database-host:5432/tldrbot
